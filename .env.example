# Variable names only. Copy to .env for local values; never commit .env (AGENTS.md rule 3).
#
# --- Supabase (browser) ---
# Read by src/shared/supabase.js. Use the project API URL, not its dashboard URL.
# /#/team-up/supabase checks Auth; direct chats use Supabase, other features use mocks.
# Use a publishable key or legacy anon key; enforce RLS before exposing tables.
# Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Preferred for new projects; takes precedence over the legacy anon key above.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Role-agent LLM (server-side only) ---
# Not read yet: the coach runs in MOCK mode (src/agents/llm.js).
# Set these as Supabase Edge Function secrets, never as VITE_* variables.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
